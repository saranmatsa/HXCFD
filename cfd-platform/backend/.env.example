# HX CFD Backend — example environment configuration.
# Copy this file to `.env` and edit values for your environment.
# Every key here is also documented inline; the Settings class reads them
# with case-insensitive env-var resolution (see cfd_backend/core/config.py).

# ─── Application ────────────────────────────────────────────────────────
ENVIRONMENT=development              # development | production | test
DEBUG=true                           # Enable OpenAPI docs + verbose logs
# HOST=127.0.0.1                      # Bind address (loopback only for the desktop)
# PORT=8000                           # Local port; Tauri overrides at launch
# WORKERS=1                           # uvicorn worker count

# ─── CORS (comma-separated origins; Tauri sets its own at launch) ───────
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost

# ─── Data paths (Tauri overrides at launch; defaults below are dev-local) ─
# DATA_DIR=./data
# LOGS_DIR=./logs
# PROJECTS_DIR=./projects
# TEMP_DIR=./tmp
# CACHE_DIR=./cache

# ─── Database (local-first SQLite; async via aiosqlite) ─────────────────
# DATABASE_URL=sqlite+aiosqlite:///./data/cfd.db
# DATABASE_ECHO=false                 # SQLAlchemy statement logging

# ─── Redis / Celery (OPT-IN; not required for the local-first desktop path)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── External engineering engines (auto-detected if PATH is configured) ─
# FREECAD_PATH=                       # Path to FreeCAD executable
# OPENFOAM_PATH=                      # OpenFOAM install root (etc/bashrc)
# OPENFOAM_VERSION=v2306
# GMSH_PATH=                          # Override gmsh binary
# GMSH_VERSION=4.11.0
# CFMESH_PATH=                        # Path containing cartesianMesh
# PARAVIEW_PATH=                      # Path to pvpython/paraview
# PARAVIEW_VERSION=5.12.0

# ─── Python runtime (Tauri sets these at launch for the managed runtime) ─
# PYTHON_EXECUTABLE=python
# VENV_PATH=                          # Override managed venv location

# ─── Simulation defaults ────────────────────────────────────────────────
# MAX_CONCURRENT_SIMULATIONS=2
# SIMULATION_TIMEOUT=3600             # Per-run hard cap, seconds
# DEFAULT_MESH_SIZE=0.01
# DEFAULT_TURBULENCE_MODEL=kOmegaSST

# ─── AI / PhysicsNeMo ───────────────────────────────────────────────────
# PHYSICSNEMO_ENABLED=true
# PHYSICSNEMO_MODEL_PATH=
# PHYSICSNEMO_PYTHON=                 # Python interpreter for PhysicsNeMo
# PHYSICSNEMO_CFD_PATH=
# CUDA_VISIBLE_DEVICES=0

# ─── Optimization defaults ──────────────────────────────────────────────
# NEVERGRAD_BUDGET=100
# OPENMDAO_MAX_ITER=50

# ─── Monitoring ──────────────────────────────────────────────────────────
# HEALTH_CHECK_INTERVAL=30
# METRICS_ENABLED=true
# PROMETHEUS_PORT=9090

# ─── Security ───────────────────────────────────────────────────────────
# SECRET_KEY=                          # JWT signing key — CHANGE FOR PRODUCTION
# API_KEY_HEADER=X-API-Key
# ALLOWED_API_KEYS=                    # comma-separated
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# ALLOW_REGISTRATION=true
# REQUIRE_EMAIL_VERIFICATION=false
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                   # json | console
# LOG_FILE=                           # Optional file path, rotates at 10MB x 5

# ─── Managed-desktop launch variables (set by Tauri; do not set by hand) ─
# CFD_PLATFORM_TAURI=1
# CFD_PLATFORM_TAURI_TOKEN=<per-launch secret>
